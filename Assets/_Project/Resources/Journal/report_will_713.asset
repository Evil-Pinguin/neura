  entryId: report_will_713
  title: "\u041E\u0442\u0447\u0451\u0442: \u0447\u0430\u0441\u0442\u043E\u0442\u044B \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430 \u0423\u0438\u043B\u043B\u0430"
  category: 0
  dateStamp: "\u0421\u043C\u0435\u043D\u0430 14 \u00B7 09:40"
  operatorId: "\u041E\u0424-773"
  body: "\u041F\u0430\u0446\u0438\u0435\u043D\u0442 \u0423\u0438\u043B\u043B. \u041F\u0438\u043A \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u2014 7.13 \u0413\u0446, \u0441\u0442\u0430\u0431\u0438\u043B\u0435\u043D \u0434\u0435\u0432\u044F\u0442\u044B\u0439 \u0447\u0430\u0441.
    \u0414\u043B\u044F \u043F\u043E\u0441\u0442\u0438\u043D\u0441\u0443\u043B\u044C\u0442\u043D\u043E\u0433\u043E \u0448\u0443\u043C\u0430 \u043D\u0435\u0442\u0438\u043F\u0438\u0447\u043D\u043E: \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u0438\u043A \u0440\u0430\u0441\u043F\u043E\u043B\u0437\u0430\u0435\u0442\u0441\u044F \u0432 \u043F\u0435\u0440\u0432\u044B\u0435 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430.
    \u0412\u044B\u0432\u043E\u0434: \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0443\u0433\u043B\u0443\u0431\u043B\u0451\u043D\u043D\u044B\u0439 \u0430\u043D\u0430\u043B\u0438\u0437 \u043F\u0435\u0440\u0435\u0434 \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u0435\u043C \u043A\u0435\u0439\u0441\u0430."
  detail: "\u041F\u0440\u0438\u043F\u0438\u0441\u043A\u0430 \u041A\u0438\u043C \u043D\u0430 \u043F\u043E\u043B\u044F\u0445 \u0440\u0430\u0441\u043F\u0435\u0447\u0430\u0442\u043A\u0438: \u00AB\u041E\u0444\u043E\u0440\u043C\u0438 \u043A\u0430\u043A \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439 \u0438 \u0437\u0430\u043A\u0440\u043E\u0439. \u0422\u0435\u0431\u0435 \u0437\u0430 \u044D\u0442\u043E \u043F\u043B\u0430\u0442\u044F\u0442\u00BB.
    \u041F\u043E\u0447\u0435\u0440\u043A \u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u044B\u0439."
  corruption: 0
  sortOrder: 10
