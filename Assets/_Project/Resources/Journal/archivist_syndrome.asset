  entryId: archivist_syndrome
  title: "\u0421\u043F\u0440\u0430\u0432\u043A\u0430: \u0441\u0438\u043D\u0434\u0440\u043E\u043C \u0430\u0440\u0445\u0438\u0432\u0430\u0440\u0438\u0443\u0441\u0430"
  category: 2
  dateStamp: "\u0431\u0430\u0437\u0430 \u00B7 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0434\u043E\u0441\u0442\u0443\u043F"
  operatorId: "\u2014"
  body: "\u0412\u044B\u043F\u0438\u0441\u043A\u0430 \u0438\u0437 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u0431\u0430\u0437\u044B. \u0421\u0438\u043D\u0434\u0440\u043E\u043C \u0430\u0440\u0445\u0438\u0432\u0430\u0440\u0438\u0443\u0441\u0430 \u2014 \u043F\u0440\u043E\u0444\u0437\u0430\u0431\u043E\u043B\u0435\u0432\u0430\u043D\u0438\u0435 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u0432.
    \u0421\u0442\u0430\u0434\u0438\u0438:
    1. \u0414\u0435\u0436\u0430\u0432\u044E, \u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u044B\u0435 \u0441\u043D\u044B.
    2. \u0422\u0440\u0435\u043C\u043E\u0440 \u0440\u0443\u043A, \u043D\u043E\u0441\u043E\u0432\u044B\u0435 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u044F \u043F\u0440\u0438 \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u044F\u0445.
    3. \u0421\u043B\u0443\u0445\u043E\u0432\u044B\u0435 \u0432\u0441\u0442\u0430\u0432\u043A\u0438, \u00AB\u0447\u0443\u0436\u043E\u0439\u00BB \u0433\u043E\u043B\u043E\u0441 \u0432 \u043F\u043E\u0442\u043E\u043A\u0435.
    4. \u041A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044F."
  detail: "\u0421\u0442\u0430\u0434\u0438\u044F 4 \u2014 \u0442\u043E, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0441 \u0423\u0438\u043B\u043B\u043E\u043C.
    \u0422\u044B \u2014 \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439. \u041F\u043E\u043A\u0430.
    \u041F\u0440\u0438\u043C\u0435\u0447\u0430\u043D\u0438\u0435: \u043F\u0440\u0438 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0438 \u043D\u0430 \u0441\u0438\u043D\u0434\u0440\u043E\u043C \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 \u043E\u0431\u044F\u0437\u0430\u043D \u0434\u043E\u043B\u043E\u0436\u0438\u0442\u044C.
    \u041A\u0438\u043C \u043E\u0431\u044F\u0437\u0430\u043D\u0430 \u0434\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043E \u0442\u0435\u0431\u0435."
  corruption: 0
  sortOrder: 90
