  entryId: syndrome_1
  title: "\u0421\u0438\u043c\u043f\u0442\u043e\u043c: \u0434\u0435\u0436\u0430\u0432\u044e"
  category: 2
  dateStamp: "\u0421\u043c\u0435\u043d\u0430 14"
  operatorId: "\u041e\u0424-773"
  body: "\u041a\u0438\u043c \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0444\u0440\u0430\u0437\u0443, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u0443\u0436\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430. \u0418\u043b\u0438 \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430. \u042f \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e \u0448\u043e\u0432 \u2014 \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0440\u0435\u043f\u043b\u0438\u043a\u0443 \u0441\u043a\u043b\u0435\u0438\u043b\u0438 \u0438\u0437 \u0434\u0432\u0443\u0445 \u0434\u0443\u0431\u043b\u0435\u0439."
  detail: "\u0421\u0442\u0430\u0434\u0438\u044f 1 \u043f\u043e \u0441\u043f\u0440\u0430\u0432\u043a\u0435. \u0414\u0430\u043b\u044c\u0448\u0435 \u2014 \u0442\u0440\u0435\u043c\u043e\u0440. \u041a\u0430\u0436\u0434\u043e\u0435 \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0434\u0435\u043b\u0430\u0435\u0442 \u0445\u0443\u0436\u0435."
  corruption: 0
  sortOrder: 61
