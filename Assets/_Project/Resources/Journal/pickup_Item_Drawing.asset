  entryId: pickup_Item_Drawing
  title: "\u041D\u0430\u0445\u043E\u0434\u043A\u0430: \u0434\u0435\u0442\u0441\u043A\u0438\u0439 \u0440\u0438\u0441\u0443\u043D\u043E\u043A"
  category: 1
  dateStamp: "\u2014"
  operatorId: "\u2014"
  body: "\u0414\u043E\u043C, \u0434\u0435\u0440\u0435\u0432\u043E, \u0434\u0432\u0435 \u0444\u0438\u0433\u0443\u0440\u044B \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F \u0437\u0430 \u0440\u0443\u043A\u0438. \u0421\u043B\u043E\u0436\u0435\u043D \u0432\u0447\u0435\u0442\u0432\u0435\u0440\u043E.
    \u041E\u0442\u043A\u0443\u0434\u0430 \u043E\u043D \u0443 \u043C\u0435\u043D\u044F \u2014 \u043D\u0435 \u043F\u043E\u043C\u043D\u044E."
  detail: "\u0412 \u0443\u0433\u043B\u0443 \u043F\u043E\u0434\u043F\u0438\u0441\u044C \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u043E\u043C: \u00AB\u041C\u0430\u0448\u0430, 6 \u043B\u0435\u0442\u00BB.
    \u041E\u0434\u043D\u0430 \u0438\u0437 \u0444\u0438\u0433\u0443\u0440 \u0441\u0442\u0451\u0440\u0442\u0430 \u043B\u0430\u0441\u0442\u0438\u043A\u043E\u043C. \u0421\u0442\u0430\u0440\u0430\u0442\u0435\u043B\u044C\u043D\u043E. \u0414\u043E \u0434\u044B\u0440\u044B.
    \u0422\u044B \u0434\u0435\u0440\u0436\u0430\u043B \u044D\u0442\u043E\u0442 \u043B\u0438\u0441\u0442\u043E\u043A \u0440\u0430\u043D\u044C\u0448\u0435. \u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u044D\u0442\u043E."
  corruption: 0.05
  sortOrder: 55
