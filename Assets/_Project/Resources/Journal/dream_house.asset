  title: "\u0421\u043E\u043D: \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439 \u0434\u043E\u043C"
  category: 1
  dateStamp: "\u2014"
  operatorId: "\u2014"
  body: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439 \u0434\u043E\u043C. \u041F\u0430\u0445\u043D\u0435\u0442 \u043F\u044B\u043B\u044C\u044E \u0438 \u0441\u043C\u043E\u043B\u043E\u0439.
    \u0417\u0430 \u043E\u043A\u043D\u043E\u043C \u2014 \u0442\u0435\u043C\u043D\u043E\u0442\u0430. \u0425\u043E\u0442\u044F \u0447\u0442\u043E \u0442\u0430\u043C \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C? \u041D\u0435 \u043F\u043E\u043C\u043D\u044E."
  detail: "\u041A\u0440\u043E\u0432\u0430\u0442\u044C \u0437\u0430\u0441\u0442\u0435\u043B\u0435\u043D\u0430. \u041A\u0442\u043E-\u0442\u043E \u0436\u0434\u0430\u043B.
    \u0418\u043B\u0438 \u0436\u0434\u0451\u0442."
  corruption: 0.06
