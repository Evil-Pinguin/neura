  entryId: syndrome_3
  title: "\u0421\u0438\u043c\u043f\u0442\u043e\u043c: \u0447\u0443\u0436\u043e\u0439 \u0433\u043e\u043b\u043e\u0441"
  category: 1
  dateStamp: "\u0421\u043c\u0435\u043d\u0430 14"
  operatorId: "\u041e\u0424-773"
  body: "\u041e\u043d \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0438\u0440\u0443\u0435\u0442. \u0418\u043d\u043e\u0433\u0434\u0430 \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442. \u0418\u043d\u043e\u0433\u0434\u0430 \u0432\u0440\u0451\u0442. \u042f \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u044e, \u043a\u043e\u0433\u0434\u0430 \u0432\u0440\u0451\u0442. \u041a\u0430\u0436\u0435\u0442\u0441\u044f, \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u044e. \u041f\u043e\u0447\u0435\u0440\u043a \u043c\u043e\u0439."
  detail: "\u0421\u0442\u0430\u0434\u0438\u044f 3. \u00ab\u041d\u0435 \u0440\u0430\u0437\u0433\u043e\u0432\u0430\u0440\u0438\u0432\u0430\u0439\u0442\u0435 \u0441 \u0433\u043e\u043b\u043e\u0441\u0430\u043c\u0438. \u041e\u043d\u0438 \u043d\u0435 \u0432\u0430\u0448\u0438 \u043a\u043e\u043b\u043b\u0435\u0433\u0438\u00bb. \u0410 \u0447\u044c\u0438?"
  corruption: 0.1
  sortOrder: 63
