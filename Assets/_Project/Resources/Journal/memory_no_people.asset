  entryId: memory_no_people
  title: "\u041D\u0435\u0442 \u043B\u044E\u0434\u0435\u0439"
  category: 1
  dateStamp: "\u2014"
  operatorId: "\u2014"
  body: "\u0414\u043E\u043C \u0446\u0435\u043B\u044B\u0439. \u041C\u0435\u0431\u0435\u043B\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0430\u0445. \u041D\u0430 \u0441\u0442\u0435\u043D\u0435 \u2014 \u0434\u0435\u0442\u0441\u043A\u0438\u0439 \u0440\u0438\u0441\u0443\u043D\u043E\u043A.
    \u041B\u044E\u0434\u0435\u0439 \u043D\u0435\u0442. \u041D\u0438\u043A\u043E\u0433\u043E. \u0422\u0430\u043A \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0434\u0430\u0436\u0435 \u0432 \u0441\u0442\u0451\u0440\u0442\u044B\u0445 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u0445."
  detail: "\u041A\u0438\u043C \u043F\u043E \u0441\u0432\u044F\u0437\u0438: \u00AB\u041F\u043E\u0440\u043E\u0433 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043D. \u041D\u0443\u0436\u043D\u043E \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C\u00BB.
    \u041E\u043D\u0430 \u0432\u0440\u0451\u0442. \u041F\u043E\u0440\u043E\u0433 \u0432 \u043D\u043E\u0440\u043C\u0435. \u041E\u043D\u0430 \u0445\u043E\u0447\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u044F \u0432\u044B\u0448\u0435\u043B."
  corruption: 0.08
  sortOrder: 110
