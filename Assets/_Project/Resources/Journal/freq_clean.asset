  entryId: freq_clean
  title: "\u041E\u0442\u0447\u0451\u0442: \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441 \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442"
  category: 0
  dateStamp: "\u0430\u0432\u0442\u043E \u00B7 \u043A\u043E\u043D\u0441\u043E\u043B\u044C"
  operatorId: "\u041E\u0424-773"
  body: "\u0427\u0430\u0441\u0442\u043E\u0442\u0430 \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D\u0430. \u0420\u0435\u0437\u043E\u043D\u0430\u043D\u0441 \u0441\u0442\u0430\u0431\u0438\u043B\u0435\u043D. \u0424\u0430\u0439\u043B \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430 \u043E\u0431\u043D\u043E\u0432\u043B\u0451\u043D.
    \u0410\u043D\u043E\u043C\u0430\u043B\u0438\u0439 \u043D\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E."
  detail: "\u041F\u043E\u0434\u043F\u0438\u0441\u044C \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430: \u041E\u0424-773.
    \u0428\u0442\u0430\u0442\u043D\u0430\u044F \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0430. \u0422\u0430\u043A \u0438 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C. \u0412\u0441\u0435\u0433\u0434\u0430."
  corruption: 0
  sortOrder: 30
