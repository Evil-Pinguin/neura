  entryId: dream_static
  title: "\u0421\u043e\u043d: \u043f\u043e\u043c\u0435\u0445\u0438"
  category: 1
  dateStamp: "\u0421\u043c\u0435\u043d\u0430 14"
  operatorId: "\u041e\u0424-773"
  body: "\u0414\u043e\u043c \u0438\u0437 \u0448\u0443\u043c\u0430. \u0421\u0442\u0435\u043d\u044b \u0433\u0443\u0434\u044f\u0442 \u043d\u0430 7.13. \u0413\u043e\u043b\u043e\u0441 \u0441\u0447\u0438\u0442\u0430\u0435\u0442: \u0441\u0442\u043e \u0441\u043e\u0440\u043e\u043a \u043e\u0434\u0438\u043d... \u0441\u0442\u043e \u0441\u043e\u0440\u043e\u043a \u0434\u0432\u0430... \u0441\u0442\u043e \u0441\u043e\u0440\u043e\u043a \u0442\u0440\u0438. \u042f \u043f\u0440\u043e\u0441\u043d\u0443\u043b\u0441\u044f \u0434\u043e \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u043e\u043d \u043d\u0430\u0437\u0432\u0430\u043b \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0435 \u0447\u0438\u0441\u043b\u043e."
