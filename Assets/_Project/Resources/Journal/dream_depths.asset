  entryId: dream_depths
  title: "\u0421\u043e\u043d: \u0433\u043b\u0443\u0431\u0438\u043d\u0430"
  category: 2
  dateStamp: "\u0421\u043c\u0435\u043d\u0430 14"
  operatorId: "\u041e\u0424-773"
  body: "\u0422\u043e\u0442 \u0436\u0435 \u0434\u043e\u043c. \u041d\u043e \u0434\u0432\u0435\u0440\u0438 \u0441\u0442\u0430\u043b\u0438 \u0431\u043e\u043b\u044c\u0448\u0435, \u0430 \u043a\u043e\u0440\u0438\u0434\u043e\u0440 \u2014 \u0434\u043b\u0438\u043d\u043d\u0435\u0435. \u0417\u0430 \u0434\u0432\u0435\u0440\u044f\u043c\u0438 \u043a\u0442\u043e-\u0442\u043e \u0434\u044b\u0448\u0438\u0442. \u042f \u043d\u0435 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u043b. \u041a\u0430\u0436\u0435\u0442\u0441\u044f, \u043e\u043d\u043e \u0437\u043d\u0430\u0435\u0442, \u0447\u0442\u043e \u044f \u043d\u0435 \u043e\u0442\u043a\u0440\u043e\u044e."
  detail: ""
  corruption: 0
  sortOrder: 51
