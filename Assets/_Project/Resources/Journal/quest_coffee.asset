  title: "\u041f\u043e\u0431\u043e\u0447\u043a\u0430: \u043a\u043e\u0444\u0435\u043c\u0430\u0448\u0438\u043d\u0430 \u043f\u043e\u0447\u0438\u043d\u0435\u043d\u0430"
  category: 0
  dateStamp: "\u0421\u043c\u0435\u043d\u0430 14"
  operatorId: "\u041e\u0424-773"
  body: "\u0417\u0430\u043c\u0435\u043d\u0438\u043b \u043f\u0440\u0435\u0434\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435\u043b\u044c. \u041c\u0430\u0448\u0438\u043d\u0430 \u0437\u0430\u0443\u0440\u0447\u0430\u043b\u0430 \u043a\u0430\u043a \u043d\u0438 \u0432 \u0447\u0451\u043c \u043d\u0435 \u0431\u044b\u0432\u0430\u043b\u043e. \u041f\u0435\u0440\u0432\u0430\u044f \u0447\u0430\u0448\u043a\u0430 \u043f\u043e\u0441\u043b\u0435 \u0440\u0435\u043c\u043e\u043d\u0442\u0430 \u2014 \u0441\u0430\u043c\u0430\u044f \u0432\u043a\u0443\u0441\u043d\u0430\u044f. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043a\u0430\u0436\u0435\u0442\u0441\u044f."
