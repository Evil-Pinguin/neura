  entryId: note_coord_2
  title: "\u0417\u0430\u043f\u0438\u0441\u043a\u0430: \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435"
  category: 0
  dateStamp: "\u0421\u043c\u0435\u043d\u0430 14"
  operatorId: "\u041e\u0424-773"
  body: "\u00ab\u0412\u0430\u0448 \u043e\u0442\u043a\u0430\u0437 \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d. \u041d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0441\u044f. \u0421\u043f\u0438\u0442\u0435 \u0445\u043e\u0440\u043e\u0448\u043e \u2014 \u043c\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043c. \u041a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u043e\u0440.\u00bb"
  detail: "\u041b\u0435\u0436\u0430\u043b\u0430 \u043d\u0430 \u0441\u0442\u043e\u0439\u043a\u0435 \u0432 \u0445\u043e\u043b\u043b\u0435. \u041e\u0445\u0440\u0430\u043d\u043d\u0438\u043a \u043a\u043b\u044f\u043d\u0451\u0442\u0441\u044f, \u0447\u0442\u043e \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u043b."
  corruption: 0
  sortOrder: 42
