  entryId: will_anomaly
  title: "\u0410\u041D\u041E\u041C\u0410\u041B\u0418\u042F: \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442"
  category: 1
  dateStamp: "\u0430\u0432\u0442\u043E \u00B7 \u043A\u043E\u043D\u0441\u043E\u043B\u044C"
  operatorId: "\u041E\u0424-7#3"
  body: "\u0412 \u043F\u043E\u0442\u043E\u043A\u0435 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430 \u0423\u0438\u043B\u043B\u0430 \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442. \u0418\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u043D\u0435 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D.
    \u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0430: \u00AB\u2026\u0418\u041D\u0426\u0418\u0414\u0415\u041D\u0422 7-\u0411 \u041B\u041E\u041A\u0410\u041B\u0418\u0417\u041E\u0412\u0410\u041D. \u0421\u0412\u0418\u0414\u0415\u0422\u0415\u041B\u0415\u0419: 143. \u0417\u0410\u041F\u0423\u0421\u041A\u0410\u042E \u041F\u0420\u041E\u0422\u041E\u041A\u041E\u041B\u2026\u00BB
    \u0413\u043E\u043B\u043E\u0441 \u0441\u043F\u043E\u043A\u043E\u0435\u043D. \u041F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u0435\u043D. \u0417\u043D\u0430\u043A\u043E\u043C."
  detail: "\u0413\u043E\u043B\u043E\u0441\u043E\u0432\u043E\u0439 \u043B\u043E\u0433, \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0441\u043A\u0438\u0439 \u043A\u0430\u043D\u0430\u043B. ID \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u0443\u0442\u0435\u0440\u044F\u043D: \u041E\u0424-7#3.
    \u0422\u0432\u043E\u0439 ID \u2014 \u041E\u0424-773.
    \u0421\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435? \u0412 \u044D\u0442\u043E\u0439 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0439 \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442."
  corruption: 0.1
  sortOrder: 40
