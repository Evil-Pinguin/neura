  entryId: syndrome_4
  title: "\u0421\u0438\u043c\u043f\u0442\u043e\u043c: \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0441\u0442\u0430\u0434\u0438\u044f"
  category: 1
  dateStamp: "\u0421\u043c\u0435\u043d\u0430 14"
  operatorId: "\u041e\u0424-773"
  body: "\u042f \u2014 \u044d\u0442\u043e \u044f? \u041f\u043e\u0447\u0435\u0440\u043a \u0432 \u0436\u0443\u0440\u043d\u0430\u043b\u0435 \u043c\u043e\u0439. \u041c\u044b\u0441\u043b\u0438 \u2014 \u043d\u0435 \u0443\u0432\u0435\u0440\u0435\u043d. \u0413\u043e\u043b\u043e\u0441 \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e \u043e\u043d \u2014 \u044d\u0442\u043e \u044f. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043e\u043d \u0432\u0440\u0451\u0442. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0435\u0442."
  detail: "\u0421\u0442\u0430\u0434\u0438\u044f 4, \u043a\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f. \u0414\u0430\u043b\u044c\u0448\u0435 \u0432 \u0441\u043f\u0440\u0430\u0432\u043a\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u043e\u0447\u0435\u0440\u043a."
  corruption: 0.25
  sortOrder: 64
