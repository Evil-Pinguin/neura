  entryId: achievement_docs
  title: "\u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435: \u0430\u0440\u0445\u0438\u0432\u0430\u0440\u0438\u0443\u0441"
  category: 0
  dateStamp: "\u0421\u043c\u0435\u043d\u0430 14"
  operatorId: "\u041e\u0424-773"
  body: "\u0412\u0441\u0435 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0441\u043e\u0431\u0440\u0430\u043d\u044b: \u043e\u0442\u0447\u0451\u0442\u044b, \u0437\u0430\u043f\u0438\u0441\u043a\u0438, \u0441\u043f\u0440\u0430\u0432\u043a\u0430. \u041a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u043e\u0440 \u0431\u044b \u043d\u0435 \u043e\u0434\u043e\u0431\u0440\u0438\u043b. \u041a\u0438\u043c \u0431\u044b \u0443\u0441\u043c\u0435\u0445\u043d\u0443\u043b\u0430\u0441\u044c. \u0413\u043e\u043b\u043e\u0441 \u043c\u043e\u043b\u0447\u0438\u0442 \u2014 \u0432\u0438\u0434\u0438\u043c\u043e, \u0442\u043e\u0436\u0435 \u0447\u0438\u0442\u0430\u0435\u0442."
