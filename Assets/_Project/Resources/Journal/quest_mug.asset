  entryId: quest_mug
  title: "\u041f\u043e\u0431\u043e\u0447\u043a\u0430: \u043a\u0440\u0443\u0436\u043a\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0430"
  category: 0
  dateStamp: "\u0421\u043c\u0435\u043d\u0430 14"
  operatorId: "\u041e\u0424-773"
  body: "\u0412\u0435\u0440\u043d\u0443\u043b \u041a\u0438\u043c \u043a\u0440\u0443\u0436\u043a\u0443. \u041e\u043d\u0430 \u0438\u0441\u043a\u0430\u043b\u0430 \u0435\u0451 \u043c\u0435\u0441\u044f\u0446. \u0423\u043b\u044b\u0431\u043d\u0443\u043b\u0430\u0441\u044c \u2014 \u043f\u043e-\u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u043c\u0443, \u043d\u0435 \u0440\u0430\u0431\u043e\u0447\u0435\u0439 \u0443\u043b\u044b\u0431\u043a\u043e\u0439. \u0421\u0442\u043e\u0438\u0442 \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u044c: \u041a\u0438\u043c \u0443\u043c\u0435\u0435\u0442 \u0443\u043b\u044b\u0431\u0430\u0442\u044c\u0441\u044f."
