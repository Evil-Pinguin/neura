  displayName: "\u0421\u0438\u043D\u0438\u0439 \u043A\u043B\u044E\u0447 \u0434\u043E\u0441\u0442\u0443\u043F\u0430"
  description: "\u0421\u0438\u043D\u0438\u0439 \u043A\u043B\u044E\u0447-\u043A\u0430\u0440\u0442\u0430. \u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0434\u0432\u0435\u0440\u044C \u0438\u0437 \u0445\u043E\u043B\u043B\u0430 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E.
    \u0422\u0430\u043A\u0438\u0435 \u0435\u0441\u0442\u044C \u043D\u0435 \u0443 \u0432\u0441\u0435\u0445."
  detail: "\u041D\u0430 \u043E\u0431\u043E\u0440\u043E\u0442\u0435 \u043D\u0430\u043A\u043B\u0435\u0439\u043A\u0430: \u00AB\u041E\u0424-773\u00BB. \u0422\u0432\u043E\u0439 ID.
    \u041A\u043B\u044E\u0447 \u0438\u043C\u0435\u043D\u043D\u043E\u0439. \u041F\u043E\u0442\u0435\u0440\u044F\u0435\u0448\u044C \u2014 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C\u0441\u044F \u0431\u0443\u0434\u0435\u0448\u044C \u0434\u043E\u043B\u0433\u043E."
  glyph: "\u0421"
  realm: 0
