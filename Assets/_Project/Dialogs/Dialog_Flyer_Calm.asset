  m_Script: {fileID: 11500000, guid: 991fd9485f4a98b4698e340a83bc6f72, type: 3}
  m_Name: Dialog_Flyer_Calm
  m_EditorClassIdentifier: 
  lines:
  - speaker: "\u0424\u041b\u0410\u0415\u0420"
    text: "\u0421\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a \u041c. \u043f\u0440\u043e\u0448\u0451\u043b \u043f\u043b\u0430\u043d\u043e\u0432\u0443\u044e \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0443. \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0442."
    choices: []
    endAfterLine: 0
  - speaker: "\u0424\u041b\u0410\u0415\u0420"
    text: "\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u043c \u0437\u0430 \u0441\u043e\u0437\u043d\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u0422\u0430\u043a \u0434\u0435\u0440\u0436\u0430\u0442\u044c."
    choices: []
    endAfterLine: 0
  - speaker: "\u0424\u041b\u0410\u0415\u0420"
    text: "\u041f\u043e\u043c\u043d\u0438\u0442\u0435: \u0441\u0432\u043e\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0430 \u2014 \u0437\u0430\u043b\u043e\u0433 \u0432\u0430\u0448\u0435\u0433\u043e \u0431\u043b\u0430\u0433\u043e\u043f\u043e\u043b\u0443\u0447\u0438\u044f."
    choices: []
    endAfterLine: 0
