  m_Script: {fileID: 11500000, guid: 991fd9485f4a98b4698e340a83bc6f72, type: 3}
  m_Name: Dialog_Kim_DejaVu
  m_EditorClassIdentifier: 
  lines:
  - speaker: "\u041c\u0430\u0439\u043a"
    text: "\u0421\u0442\u043e\u043f. \u0422\u044b \u044d\u0442\u043e \u0443\u0436\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430. \u0421\u043b\u043e\u0432\u043e \u0432 \u0441\u043b\u043e\u0432\u043e."
    choices: []
    endAfterLine: 0
  - speaker: "\u041a\u0438\u043c"
    text: "\u041d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430. ...\u0418\u043b\u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430?"
    choices: []
    endAfterLine: 0
    emotion: sad
  - speaker: "\u041a\u0438\u043c"
    text: "\u0410\u0440\u0445\u0438\u0432\u0430\u0440\u0438\u0443\u0441\u044b \u0437\u043e\u0432\u0443\u0442 \u044d\u0442\u043e \u0434\u0435\u0436\u0430\u0432\u044e. \u041f\u0435\u0440\u0432\u0430\u044f \u0441\u0442\u0430\u0434\u0438\u044f. \u0418\u0434\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0439."
    choices: []
    endAfterLine: 0
    emotion: serious
