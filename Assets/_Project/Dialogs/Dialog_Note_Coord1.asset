  m_Name: Dialog_Note_Coord1
  m_EditorClassIdentifier: 
  lines:
  - speaker: "\u0417\u0410\u041f\u0418\u0421\u041a\u0410"
    text: "\u041e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0443 \u041c. \u0412\u0430\u0448 \u043e\u0442\u0447\u0451\u0442 \u043f\u0440\u0438\u043d\u044f\u0442. \u041d\u0430\u043f\u043e\u043c\u0438\u043d\u0430\u044e: \u043f\u0438\u043a\u0438 7.0\u20137.2 \u0443 \u043f\u043e\u0441\u0442\u0438\u043d\u0441\u0443\u043b\u044c\u0442\u043d\u044b\u0445 \u043f\u0430\u0446\u0438\u0435\u043d\u0442\u043e\u0432 \u2014 \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u043d\u043e\u0440\u043c\u044b. \u041d\u0435 \u0438\u0449\u0438\u0442\u0435 \u0430\u043d\u043e\u043c\u0430\u043b\u0438\u0439 \u0442\u0430\u043c, \u0433\u0434\u0435 \u0438\u0445 \u043d\u0435\u0442."
    choices: []
    endAfterLine: 0
  - speaker: "\u0417\u0410\u041f\u0418\u0421\u041a\u0410"
    text: "\u041a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u043e\u0440. P.S. \u041a\u0440\u0430\u0441\u0438\u0432\u0430\u044f \u0446\u0438\u0444\u0440\u0430, \u043a\u0441\u0442\u0430\u0442\u0438. 7.13."
    choices: []
    endAfterLine: 0
