  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 991fd9485f4a98b4698e340a83bc6f72, type: 3}
  m_Name: Dialog_Kim_Worried
  m_EditorClassIdentifier: 
  lines:
  - speaker: "\u041a\u0438\u043c"
    text: "\u041c\u0430\u0439\u043a. \u0423 \u0442\u0435\u0431\u044f \u043a\u0440\u043e\u0432\u044c. \u041e\u043f\u044f\u0442\u044c."
    choices: []
    endAfterLine: 0
    emotion: sad
  - speaker: "\u041c\u0430\u0439\u043a"
    text: "\u041f\u0440\u043e\u0441\u0442\u043e \u0441\u043e\u0441\u0443\u0434\u044b. \u0412\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f \u043f\u044b\u043b\u044c\u043d\u044b\u0435."
    choices: []
    endAfterLine: 0
  - speaker: "\u041a\u0438\u043c"
    text: "\u042d\u0442\u043e \u0442\u0440\u0435\u0442\u044c\u044f \u0441\u0442\u0430\u0434\u0438\u044f. \u042f \u0432\u0438\u0434\u0435\u043b\u0430 \u0442\u0430\u043a\u0438\u0445. \u041e\u043d\u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442 \u0441\u043b\u044b\u0448\u0430\u0442\u044c \u0433\u043e\u043b\u043e\u0441\u0430."
    choices: []
    endAfterLine: 0
    emotion: serious
  - speaker: "\u041a\u0438\u043c"
    text: "\u041f\u0440\u043e\u0448\u0443 \u0442\u0435\u0431\u044f. \u041a\u0430\u0431\u0438\u043d\u0435\u0442 \u0442\u0440\u0438. \u041f\u043e\u043a\u0430 \u0442\u044b \u0435\u0449\u0451 \u0442\u044b."
    choices: []
    endAfterLine: 0
    emotion: sad
