MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 991fd9485f4a98b4698e340a83bc6f72, type: 3}
  m_Name: Dialog_Kim
  m_EditorClassIdentifier: 
  lines:
  - speaker: "\u041A\u0438\u043C"
    text: "\u0422\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u0442\u0430\u043A,
      \u0431\u0443\u0434\u0442\u043E \u0432\u0438\u0434\u0435\u043B \u043F\u0440\u0438\u0437\u0440\u0430\u043A\u0430.
      \u0427\u0442\u043E \u043D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437?"
    choices: []
    endAfterLine: 0
    emotion: smile
  - speaker: "\u041C\u0430\u0439\u043A"
    text: "\u0427\u0430\u0441\u0442\u043E\u0442\u044B \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430
      \u0423\u0438\u043B\u043B\u0430. \u041F\u0438\u043A \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 7.13 \u0443\u0436\u0435 \u0434\u0435\u0432\u044F\u0442\u044C \u0447\u0430\u0441\u043E\u0432.
      \u0422\u0430\u043A\u043E\u0435 \u0441\u0430\u043C\u043E \u043D\u0435 \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044F."
    choices: []
    endAfterLine: 0
  - speaker: "\u041A\u0438\u043C"
    text: "\u0421\u0442\u0430\u0440\u043E\u0435 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435.
      \u0423 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432 \u043F\u043E\u0441\u043B\u0435
      \u043F\u043E\u043F\u044B\u0442\u043A\u0438 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043A\u0440\u0438\u0432\u044B\u0435 \u0433\u0440\u0430\u0444\u0438\u043A\u0438.
      \u0422\u044B \u043D\u0435 \u043F\u0435\u0440\u0432\u044B\u0439 \u043C\u0435\u0441\u044F\u0446
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C."
    choices: []
    endAfterLine: 0
    emotion: serious
  - speaker: "\u041C\u0430\u0439\u043A"
    text: "\u0428\u0443\u043C \u043D\u0435 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u0434\u0435\u0432\u044F\u0442\u044C \u0447\u0430\u0441\u043E\u0432 \u043F\u043E\u0434\u0440\u044F\u0434,
      \u041A\u0438\u043C."
    choices: []
    endAfterLine: 0
  - speaker: "\u041A\u0438\u043C"
    text: "\u041E\u0444\u043E\u0440\u043C\u0438 \u043A\u0430\u043A \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439
      \u043A\u0435\u0439\u0441 \u0438 \u0437\u0430\u043A\u0440\u043E\u0439 \u0435\u0433\u043E.
      \u0422\u0435\u0431\u0435 \u0437\u0430 \u044D\u0442\u043E \u043F\u043B\u0430\u0442\u044F\u0442."
    choices: []
    endAfterLine: 0
    emotion: serious
  - speaker: "\u041C\u0430\u0439\u043A"
    text: ...
    choices:
    - label: "\xAB\u0428\u0443\u043C \u0442\u0430\u043A \u0441\u0435\u0431\u044F
        \u043D\u0435 \u0432\u0435\u0434\u0451\u0442.\xBB"
      nextIndex: 6
      effect: 0
    - label: "\xAB...\u041B\u0430\u0434\u043D\u043E.\xBB"
      nextIndex: 8
      effect: 0
    endAfterLine: 0
  - speaker: "\u041A\u0438\u043C"
    text: "\u0422\u0435\u0431\u0435 \u0432\u0438\u0434\u043D\u0435\u0435. \u0422\u044B
      \u0436\u0435 \u0443 \u043D\u0430\u0441 \xAB\u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442
      \u043F\u043E \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044F\u043C\xBB. \u041F\u043E\u043C\u043D\u0438\u0448\u044C,
      \u0447\u0435\u043C \u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C \u0442\u0430
      \u0438\u0441\u0442\u043E\u0440\u0438\u044F? \u042F \u2014 \u043D\u0435\u0442.
      \u0415\u0451 \u043F\u043E\u0447\u0438\u0441\u0442\u0438\u043B\u0438."
    choices: []
    endAfterLine: 0
    emotion: serious
  - speaker: "\u041A\u0438\u043C"
    text: "\u0417\u0430\u043A\u0440\u044B\u0432\u0430\u0439 \u043A\u0435\u0439\u0441.
      \u0418 \u043F\u0440\u0438\u043B\u044F\u0433. \u0422\u0435\u0431\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F."
    choices: []
    endAfterLine: 0
    emotion: serious
  - speaker: "\u041A\u0438\u043C"
    text: "\u0412\u043E\u0442 \u0438 \u043C\u043E\u043B\u043E\u0434\u0435\u0446.
      \u0418, \u041C\u0430\u0439\u043A... \u043C\u0435\u043D\u044C\u0448\u0435 \u0434\u0443\u043C\u0430\u0439
      \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435. \u0414\u0443\u043C\u0430\u0435\u0448\u044C
      \u043C\u0435\u043D\u044C\u0448\u0435 \u2014 \u0441\u043F\u0438\u0448\u044C
      \u043B\u0443\u0447\u0448\u0435."
    choices: []
    endAfterLine: 0
    emotion: smile
