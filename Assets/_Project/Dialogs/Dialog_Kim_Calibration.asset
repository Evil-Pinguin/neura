%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 991fd9485f4a98b4698e340a83bc6f72, type: 3}
  m_Name: Dialog_Kim_Calibration
  m_EditorClassIdentifier: 
  lines:
  - speaker: "\u041A\u0438\u043C"
    text: "\u0422\u044B \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0432\u0447\u0435\u0440\u0430
      \u043F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u043D\u044B. \u042F \u0432\u0438\u0434\u0435\u043B\u0430
      \u043B\u043E\u0433\u0438."
    choices: []
    endAfterLine: 0
    emotion: serious
  - speaker: "\u041C\u0430\u0439\u043A"
    text: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439 \u0430\u043D\u0430\u043B\u0438\u0437.
      \u0427\u0430\u0441\u0442\u043E\u0442\u0430 \u043D\u0435 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u0434\u0435\u0432\u044F\u0442\u044C \u0447\u0430\u0441\u043E\u0432 \u0441\u0430\u043C\u0430
      \u043F\u043E \u0441\u0435\u0431\u0435."
    choices: []
    endAfterLine: 0
  - speaker: "\u041A\u0438\u043C"
    text: "\u041E\u0434\u0438\u043D. \u041D\u043E\u0447\u044C\u044E. \u0421 \u0444\u0430\u0439\u043B\u043E\u043C,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0442\u0435\u0431\u0435 \u043D\u0435
      \u043D\u0430\u0437\u043D\u0430\u0447\u0430\u043B\u0438. \u042D\u0442\u043E
      \u043D\u0435 \xAB\u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439
      \u0430\u043D\u0430\u043B\u0438\u0437\xBB, \u0438 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C."
    choices: []
    endAfterLine: 0
    emotion: serious
  - speaker: "\u041A\u0438\u043C"
    text: "\u042F \u043F\u043E\u0434\u0430\u043B\u0430 \u0437\u0430\u043F\u0440\u043E\u0441
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u043E\u0440\u0443. \u0417\u0430\u0432\u0442\u0440\u0430
      \u0443\u0442\u0440\u043E\u043C \u2014 \u043F\u0440\u043E\u0444\u0438\u043B\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043A\u0430. \u0412\u043E\u0441\u0435\u043C\u044C
      \u043C\u0438\u043D\u0443\u0442."
    choices: []
    endAfterLine: 0
    emotion: serious
  - speaker: "\u041C\u0430\u0439\u043A"
    text: "\u042F \u043D\u0435 \u043F\u0430\u0446\u0438\u0435\u043D\u0442, \u041A\u0438\u043C."
    choices: []
    endAfterLine: 0
  - speaker: "\u041A\u0438\u043C"
    text: "\u041A\u0430\u0436\u0434\u044B\u0439, \u043A\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0441 \u0441\u044B\u0440\u044B\u043C\u0438 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C\u0438,
      \u2014 \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u043F\u0430\u0446\u0438\u0435\u043D\u0442.
      \u041F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u0439 \u0444\u043B\u0430\u0435\u0440
      \u0432 \u0445\u043E\u043B\u043B\u0435. D\xE9j\xE0 vu. \u0414\u0440\u043E\u0436\u044C
      \u0432 \u0440\u0443\u043A\u0430\u0445. \u041E\u0449\u0443\u0449\u0435\u043D\u0438\u0435
      \u0447\u0443\u0436\u0438\u0445 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439.
      \u0422\u0440\u0438 \u0438\u0437 \u0447\u0435\u0442\u044B\u0440\u0451\u0445,
      \u041C\u0430\u0439\u043A."
    choices: []
    endAfterLine: 0
    emotion: serious
  - speaker: "\u041C\u0430\u0439\u043A"
    text: ...
    choices:
    - label: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F.
        \u0412\u043E\u0441\u0435\u043C\u044C \u043C\u0438\u043D\u0443\u0442 \u2014
        \u043D\u0435 \u0441\u0440\u043E\u043A."
      nextIndex: 12
      effect: 1
    - label: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F. \u042F
        \u0445\u043E\u0447\u0443 \u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E
        \u044D\u0442\u043E \u0431\u044B\u043B\u043E."
      nextIndex: 14
      effect: 2
    endAfterLine: 0
  - speaker: "\u041A\u0438\u043C"
    text: "\u042F \u0434\u0435\u043B\u0430\u043B\u0430 \u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043A\u0443.
      \u041F\u043E\u0441\u043B\u0435 \u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043B\u0443\u0447\u0430\u044F.
      \u041C\u043D\u0435 \u0441\u0442\u0430\u043B\u043E \u043B\u0435\u0433\u0447\u0435.
      \u041F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 \u043B\u0435\u0433\u0447\u0435."
    choices: []
    endAfterLine: 0
    emotion: sad
  - speaker: "\u041C\u0430\u0439\u043A"
    text: "\u0427\u0442\u043E \u0437\u0430 \u0441\u043B\u0443\u0447\u0430\u0439?"
    choices: []
    endAfterLine: 0
  - speaker: "\u041A\u0438\u043C"
    text: "\u041D\u0435 \u043F\u043E\u043C\u043D\u044E. \u0418 \u0432 \u044D\u0442\u043E\u043C
      \u0432\u0435\u0441\u044C \u0441\u043C\u044B\u0441\u043B."
    choices: []
    endAfterLine: 0
    emotion: sad
  - speaker: "\u041A\u0438\u043C"
    text: "\u0427\u0442\u043E \u043F\u0438\u0448\u0435\u043C \u0432 \u0436\u0443\u0440\u043D\u0430\u043B\u0435?"
    choices: []
    endAfterLine: 0
    emotion: serious
  - speaker: "\u041C\u0430\u0439\u043A"
    text: ...
    choices: []
    endAfterLine: 0
  - speaker: "\u041A\u0438\u043C"
    text: "\u0423\u043C\u043D\u0438\u0446\u0430. \u041A\u0430\u0431\u0438\u043D\u0435\u0442
      \u0442\u0440\u0438, \u0432 \u0432\u043E\u0441\u0435\u043C\u044C \u0443\u0442\u0440\u0430.
      \u041D\u0435 \u043E\u043F\u0430\u0437\u0434\u044B\u0432\u0430\u0439."
    choices: []
    endAfterLine: 0
    emotion: smile
  - speaker: "\u041A\u0438\u043C"
    text: "\u0418, \u041C\u0430\u0439\u043A... \u0442\u043E, \u0447\u0442\u043E \u0442\u0435\u0431\u0435
      \u043F\u043E\u043C\u0435\u0440\u0435\u0449\u0438\u043B\u043E\u0441\u044C \u043D\u0430
      \u044D\u043A\u0440\u0430\u043D\u0435, \u2014 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0430
      \u043A\u0430\u043D\u0430\u043B\u0430. \u0421\u0442\u0430\u0440\u043E\u0435
      \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435. \u0421\u0438\u0441\u0442\u0435\u043C\u0430
      \u0443\u0436\u0435 \u0432\u0441\u0451 \u0437\u0430\u043F\u0438\u0441\u0430\u043B\u0430
      \u043A\u0430\u043A \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E."
    choices: []
    endAfterLine: 1
    emotion: sad
  - speaker: "\u041A\u0438\u043C"
    text: ...
    choices: []
    endAfterLine: 0
  - speaker: "\u041A\u0438\u043C"
    text: "\u0422\u043E\u0433\u0434\u0430 \u0445\u043E\u0442\u044F \u0431\u044B \u043D\u0435
      \u0440\u0430\u0431\u043E\u0442\u0430\u0439 \u0441 \u0435\u0433\u043E \u0444\u0430\u0439\u043B\u043E\u043C
      \u043E\u0434\u0438\u043D. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
    choices: []
    endAfterLine: 0
    emotion: sad
  - speaker: "\u041C\u0430\u0439\u043A"
    text: "\u0425\u043E\u0440\u043E\u0448\u043E."
    choices: []
    endAfterLine: 0
  - speaker: "\u041A\u0438\u043C"
    text: "\u0422\u044B \u0436\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u043E\u0431\u044F\u0437\u0430\u043D\u0430
      \u0434\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u043E\u0440\u0443.
      \u041D\u0438\u0447\u0435\u0433\u043E \u043B\u0438\u0447\u043D\u043E\u0433\u043E,
      \u041C\u0430\u0439\u043A."
    choices: []
    endAfterLine: 0
    emotion: sad
