  lines:
  - speaker: "\u0417\u0410\u041f\u0418\u0421\u041a\u0410"
    text: "\u041c\u0430\u0439\u043a. \u0415\u0441\u043b\u0438 \u043f\u043e\u043b\u0435\u0437\u0435\u0448\u044c \u0433\u043b\u0443\u0431\u0436\u0435 \u2014 \u043d\u0435 \u0432\u0435\u0440\u044c \u0433\u043e\u043b\u043e\u0441\u0443. \u0422\u0430\u043c \u043d\u0435\u0442 \u043b\u044e\u0434\u0435\u0439. \u041b\u044e\u0434\u0435\u0439 \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0438\u0433\u0434\u0435 \u043d\u0435\u0442, \u0435\u0441\u043b\u0438 \u0432\u0434\u0443\u043c\u0430\u0442\u044c\u0441\u044f."
    choices: []
    endAfterLine: 0
  - speaker: "\u0417\u0410\u041f\u0418\u0421\u041a\u0410"
    text: "\u0421\u043e\u0442\u0440\u0438 \u044d\u0442\u0443 \u0437\u0430\u043f\u0438\u0441\u043a\u0443. \u2014 \u041a."
    choices: []
    endAfterLine: 0
