  m_Script: {fileID: 11500000, guid: 991fd9485f4a98b4698e340a83bc6f72, type: 3}
  m_Name: Dialog_Flyer
  m_EditorClassIdentifier: 
  lines:
  - speaker: "\u0424\u041B\u0410\u0415\u0420"
    text: "\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415, \u0421\u041E\u0422\u0420\u0423\u0414\u041D\u0418\u041A\u0418
      \u041B\u0410\u0411\u041E\u0420\u0410\u0422\u041E\u0420\u0418\u0418 \xABMNEMOSYNE\xBB"
    choices: []
    endAfterLine: 0
  - speaker: "\u0424\u041B\u0410\u0415\u0420"
    text: "\u0421\u0438\u043C\u043F\u0442\u043E\u043C\u044B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430: \u2014
      \u0447\u0430\u0441\u0442\u044B\u0435 d\xE9j\xE0 vu \u043D\u0430 \u0440\u0430\u0431\u043E\u0447\u0435\u043C
      \u043C\u0435\u0441\u0442\u0435; \u2014 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0438\u0435\u0441\u044F
      \u0441\u043D\u044B; \u2014 \u043D\u0435\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u043B\u044C\u043D\u044B\u0435
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0440\u0443\u043A; \u2014
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u0447\u0443\u0436\u0438\u0445
      \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439."
    choices: []
    endAfterLine: 0
  - speaker: "\u0424\u041B\u0410\u0415\u0420"
    text: "\t\u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438 \u0434\u0432\u0430
      \u0438 \u0431\u043E\u043B\u0435\u0435 \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u043E\u0432?
      \u041D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u0435
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u043E\u0440\u0443. \u0421\u0432\u043E\u0435\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F
      \u041A\u0410\u041B\u0418\u0411\u0420\u041E\u0412\u041A\u0410 \u2014 \u0437\u0430\u043B\u043E\u0433
      \u0432\u0430\u0448\u0435\u0433\u043E \u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u0438\u044F.\r\n"
    choices: []
    endAfterLine: 0
