  m_Script: {fileID: 11500000, guid: 991fd9485f4a98b4698e340a83bc6f72, type: 3}
  m_Name: Dialog_Flyer_Wanted
  m_EditorClassIdentifier: 
  lines:
  - speaker: "\u0424\u041b\u0410\u0415\u0420"
    text: "\u0420\u0410\u0417\u042b\u0421\u041a\u0418\u0412\u0410\u0415\u0422\u0421\u042f \u0421\u041e\u0417\u041d\u0410\u0422\u0415\u041b\u042c\u041d\u041e\u0421\u0422\u042c"
    choices: []
    endAfterLine: 0
  - speaker: "\u0424\u041b\u0410\u0415\u0420"
    text: "\u0421\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a \u041c. \u043e\u0442\u043a\u0430\u0437\u0430\u043b\u0441\u044f \u043e\u0442 \u043f\u043b\u0430\u043d\u043e\u0432\u043e\u0439 \u043a\u0430\u043b\u0438\u0431\u0440\u043e\u0432\u043a\u0438 \u0438 \u0441\u0442\u0430\u0432\u0438\u0442 \u043f\u043e\u0434 \u0443\u0433\u0440\u043e\u0437\u0443 \u043a\u043e\u043b\u043b\u0435\u043a\u0442\u0438\u0432. \u0421\u0438\u043c\u043f\u0442\u043e\u043c\u044b: \u0443\u043f\u0440\u044f\u043c\u0441\u0442\u0432\u043e, \u0432\u043e\u043f\u0440\u043e\u0441\u044b, \u043d\u0435\u0434\u043e\u0432\u0435\u0440\u0438\u0435."
    choices: []
    endAfterLine: 0
  - speaker: "\u0424\u041b\u0410\u0415\u0420"
    text: "\u0417\u0430\u043c\u0435\u0442\u0438\u043b\u0438 \u0441\u0438\u043c\u043f\u0442\u043e\u043c\u044b \u0443 \u043a\u043e\u043b\u043b\u0435\u0433\u0438? \u0421\u043e\u043e\u0431\u0449\u0438\u0442\u0435 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u043e\u0440\u0443. \u0410\u043d\u043e\u043d\u0438\u043c\u043d\u043e\u0441\u0442\u044c \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f. \u041f\u043e\u0447\u0442\u0438."
    choices: []
    endAfterLine: 0
