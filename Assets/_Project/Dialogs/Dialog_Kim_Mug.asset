  m_Script: {fileID: 11500000, guid: 991fd9485f4a98b4698e340a83bc6f72, type: 3}
  m_Name: Dialog_Kim_Mug
  m_EditorClassIdentifier: 
  lines:
  - speaker: "\u041a\u0438\u043c"
    text: "\u041c\u043e\u044f \u043a\u0440\u0443\u0436\u043a\u0430! \u0422\u044b \u043d\u0430\u0448\u0451\u043b \u0435\u0451. \u0413\u0434\u0435 \u043e\u043d\u0430 \u0431\u044b\u043b\u0430?"
    choices: []
    endAfterLine: 0
    emotion: smile
  - speaker: "\u041c\u0430\u0439\u043a"
    text: "\u0423 \u0441\u0442\u0435\u043d\u044b \u0432 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u0438. \u041f\u044b\u043b\u0438\u043b\u0430\u0441\u044c."
    choices: []
    endAfterLine: 0
  - speaker: "\u041a\u0438\u043c"
    text: "...\u042f \u0435\u0451 \u043c\u0435\u0441\u044f\u0446 \u0438\u0441\u043a\u0430\u043b\u0430. \u0421\u043f\u0430\u0441\u0438\u0431\u043e, \u041c\u0430\u0439\u043a. \u041f\u0440\u0430\u0432\u0434\u0430."
    choices: []
    endAfterLine: 0
    emotion: sad
