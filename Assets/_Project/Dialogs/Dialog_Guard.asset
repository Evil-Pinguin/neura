  m_Script: {fileID: 11500000, guid: 991fd9485f4a98b4698e340a83bc6f72, type: 3}
  m_Name: Dialog_Guard
  m_EditorClassIdentifier: 
  lines:
  - speaker: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A"
    text: "\u0421\u0442\u043E\u0439... \u0410, \u041C\u0430\u0439\u043A. \u0421\u0432\u043E\u0438. \u041F\u0440\u043E\u0445\u043E\u0434\u0438."
    choices: []
    endAfterLine: 0
  - speaker: "\u041C\u0430\u0439\u043A"
    text: "\u0422\u0438\u0445\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F?"
    choices: []
    endAfterLine: 0
  - speaker: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A"
    text: "\u0422\u0438\u0445\u043E. \u041F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0435\u0439 \u043D\u0435\u0442, \u0438 \u0441\u043B\u0430\u0432\u0430 \u0431\u043E\u0433\u0443. \u0412 \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u0440\u0430\u0437 \u043E\u0434\u0438\u043D \u0442\u0443\u0442 \u043F\u043E\u043B\u0447\u0430\u0441\u0430 \u0441\u0442\u043E\u044F\u043B. \u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u2014 \u0431\u0440\u0430\u0442\u0430 \u0438\u0449\u0435\u0442. \u0410 \u0441\u0430\u043C \u043D\u0435 \u043F\u043E\u043C\u043D\u0438\u0442, \u043A\u0430\u043A \u0431\u0440\u0430\u0442\u0430 \u0437\u043E\u0432\u0443\u0442."
    choices: []
    endAfterLine: 1
